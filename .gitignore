# --- Python / CV module ---
.venv/
# Separate export venv for the Hailo Dataflow Compiler (see export_hailo.py).
.venv-dfc/
# Calibration output: lighting- and camera-specific, regenerated by calibrate.py.
ball-detection-algo/params.json
__pycache__/
.pytest_cache/
*.py[cod]
*.egg-info/

# --- CAD / meshes ---
# Blender sources and exported meshes are kept out of git: they are large
# binaries that store a full copy per revision and never diff usefully.
# They live in ball_holder_model/ on disk and are shared out-of-band.
*.blend
*.blend1
*.blend2
*.stl

# --- Claude Code ---
# Shared config (.claude/settings.json) is tracked; per-user local overrides are not.
.claude/settings.local.json

# --- OS / editor cruft ---
Thumbs.db
desktop.ini
.DS_Store
.vscode/
.idea/

# --- Captured media ---
# Test photos/videos from the camera; keep the repo light. Commit deliberately
# with `git add -f` if a specific frame becomes a regression fixture.
*.mp4
*.avi
captures/

# --- ML models / training output ---
# Same reasoning as the CAD binaries above: large, opaque, and they never diff
# usefully. Trained weights are shared out-of-band; stock weights re-download.
*.pt
*.onnx
*_ncnn_model/
*_hailo_model/
*.hef
runs/
datasets/
# Exception: the small stock YOLO11n weights and their Hailo-10H export are
# committed so a fresh clone (e.g. the Pi) runs without a laptop export step.
!ball-detection-algo/yolo11n.pt
!ball-detection-algo/yolo11n_hailo_model/
!ball-detection-algo/yolo11n_hailo_model/*.hef

# --- Hailo DFC logs ---
# Written to the working directory by export_hailo.py's compiler run.
*.log
